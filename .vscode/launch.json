{
  // Dev keys come from frontend/.env.development.local, see docs/deployment.md.
  // The dev port is pinned in vite.config.ts, so we open that URL once Vite says it is ready.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server + Chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "ready in",
        "uriFormat": "http://localhost:5173",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/frontend"
      }
    },
    {
      "name": "Dev server + Edge",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "ready in",
        "uriFormat": "http://localhost:5173",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/frontend"
      }
    },
    {
      "name": "Dev server only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Debug current test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "${workspaceFolder}/frontend/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    }
  ]
}
