# Copy this to .env.development.local and fill in your development Google Cloud keys.
# Vite only loads it for `npm run dev`, and it overrides anything in .env.
# Files ending in .local are gitignored, so your keys stay out of the repo.

# OAuth client ID. Add http://localhost:5173 to its Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
# API key for the Picker. If it has website restrictions, allow http://localhost:5173/*.
VITE_GOOGLE_API_KEY=your-dev-api-key
# Project number of the dev Google Cloud project.
VITE_GOOGLE_APP_ID=

# NOTE: never put a client secret here. Anything starting with VITE_ can end up in the browser bundle.
