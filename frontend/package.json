{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ../rust-tex --target web --out-dir ../frontend/src/wasm/rust_tex_pkg --out-name rust_tex",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=79"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "latex.js": "^0.12.6",
    "trystero": "^0.24.0",
    "yjs": "^13.6.30"
  }
}
